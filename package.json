{
  "name": "@captiveorigins/payload-plugin-sponsors",
  "version": "0.3.1",
  "description": "Sponsors for Payload: a public sponsor list with optional tiers, private contacts, and sponsor updates written and sent from the admin.",
  "homepage": "https://github.com/CaptiveOrigins/payload-plugin-sponsors#readme",
  "bugs": {
    "url": "https://github.com/CaptiveOrigins/payload-plugin-sponsors/issues"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "sponsors",
    "supporters",
    "email",
    "nonprofit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptiveOrigins/payload-plugin-sponsors.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rsc": {
      "types": "./dist/rsc/index.d.ts",
      "import": "./dist/rsc/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@payloadcms/next": "^3.80.0",
    "@payloadcms/richtext-lexical": "^3.80.0",
    "@payloadcms/ui": "^3.80.0",
    "payload": "^3.80.0",
    "react": ">=19"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "graphql": "^16.14.2",
    "mongodb-memory-server": "^11.3.0",
    "next": "16.4.5",
    "payload": "3.92.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "happy-dom": "^21.0.4"
  }
}
